- content_for :head do
  = auto_discovery_link_tag :atom, titles_path(:format => :atom), { :title => "#{CONFIG[:sitename]}: New books" }

#puffbox
  %p{ :style => 'font-size: 200%' }
    Lend and borrow books with your neighbours in Sutton

  - unless current_user
    %p{ :style => 'float: right' }
      = link_to "Sign up now", :register, :class => "button"
    
  %p
    Sutton Bookshare helps you to lend and borrow books. It's free, easy to use and open to everyone who lives or works in the London Borough of Sutton.

.clear
  
- if @books.count > 0

  %p
    Browse
    = link_to "all books by subject", subjects_path
    to find something to borrow.

  %table.book_grid
    %tr
    - i = 0
    - for book in @books
      - title = book.title
      - i += 1
      %td
        - if title.image_url.present?
          = link_to (image_tag title.image_url, :height => 80, :alt => title.title_and_author), title
        - else
          = link_to title.title_and_author, title
      - if i % 10 == 0
        %tr
- else
  %p
    No books are currently available.
    = link_to "Register", :register
    to share your books with the community.
